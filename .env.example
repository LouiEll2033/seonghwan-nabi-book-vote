# Supabase 프로젝트 설정 > Database > Connection string에서 "Transaction pooler"(포트 6543) 문자열을 복사
DATABASE_URL=postgres://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 운영진이 결과 페이지 로그인 시 사용할 공유 비밀번호
ADMIN_PASSWORD=change-me

# 관리자 로그인 쿠키 서명용 임의의 긴 문자열 (외부에 노출되면 안 됨)
SESSION_SECRET=change-me-too
